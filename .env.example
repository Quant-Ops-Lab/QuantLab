# QuantLab v0.3 — copy to .env locally. Never commit real values.
QUANTLAB_MODE=research
QUANTLAB_LIVE_ORDERS_ENABLED=false
PUBLIC_API_TOKEN=
PUBLIC_ACCOUNT_ID=
SEC_USER_AGENT=QuantLabResearch operator-contact@example.com
# SQLite for local single-host; managed PostgreSQL for Render services:
QUANTLAB_EVENT_DB=artifacts/events.sqlite
QUANTLAB_MARKET_DB=artifacts/market.sqlite
QUANTLAB_ALERTS_FILE=artifacts/alerts.jsonl
# Optional, only configure after creating an SNS topic and granting publish rights:
QUANTLAB_SNS_TOPIC_ARN=
# For owned/authorized feeds, copy config/news_feeds.example.json and edit URLs.
QUANTLAB_NEWS_FEEDS=config/news_feeds.json
SEC_POLL_SECONDS=900
QUOTE_POLL_SECONDS=60

# Set QUANTLAB_REQUIRE_AUTH=1 for any externally accessible interface.
QUANTLAB_REQUIRE_AUTH=0
QUANTLAB_CONSOLE_PASSWORD=
# Optional connectors; leave unset until configured
XAI_API_KEY=
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
MASSIVE_API_KEY=
QUANTLAB_OPPORTUNITY_DIR=artifacts/opportunity
QUANTLAB_SQS_QUEUE_URL=
QUANTLAB_MQTT_HOST=

# v0.5 - all secrets server-side only
QUANTLAB_ADMIN_PASSWORD=
QUANTLAB_CRYPTO_PAIRS=BTC/USD,ETH/USD
QUANTLAB_CRYPTO_POLL_SECONDS=30
QUANTLAB_EQUITY_SYMBOLS=NVDA,AMD,MU,AVGO,TSM,MSFT
QUANTLAB_ALERT_DB=
QUANTLAB_CONSENT_DB=artifacts/consent.sqlite
# xAI is paid by usage; no free API calls are assumed
# XAI_API_KEY=

# v0.6 private outbound delivery: all optional. NEVER commit populated secrets.
QUANTLAB_DELIVERY_DB=
QUANTLAB_NOTIFICATION_MAX_AGE_SECONDS=600
QUANTLAB_DISCORD_WEBHOOK_URL=
QUANTLAB_SLACK_WEBHOOK_URL=
# SMS: choose 'sns' (IAM policy + origination eligibility) OR 'twilio'
QUANTLAB_SMS_PROVIDER=
QUANTLAB_SMS_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Encrypted email connection (465 SSL or 587 STARTTLS)
QUANTLAB_EMAIL_HOST=
QUANTLAB_EMAIL_PORT=587
QUANTLAB_EMAIL_USER=
QUANTLAB_EMAIL_PASSWORD=
QUANTLAB_EMAIL_FROM=
QUANTLAB_EMAIL_TO=
